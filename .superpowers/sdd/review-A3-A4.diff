-    results = {}
-
-    # Check existing vocabularies across both schemas
-    vocabs = [
-        v.name
-        for schema in [ml.ml_schema, ml.default_schema]
-        for v in ml.model.schemas[schema].tables.values()
-        if ml.model.is_vocabulary(v)
