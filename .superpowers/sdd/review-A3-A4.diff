-        print(f"    - Testing:  {asset_stats.get('testing_images', 'n/a')}")
-        print(f"  Features added: {asset_stats.get('features_added', 'n/a')}")
-    if not args.show_urls:
-        print("")
-        print("  Tip: Use --show-urls to display Chaise URLs for each dataset")
