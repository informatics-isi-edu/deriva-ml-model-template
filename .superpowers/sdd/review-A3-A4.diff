-        out_path = test_dir / fname
-        Image.fromarray(img).save(out_path)
-        labels[Path(fname).stem] = class_names[lbl]
-
-    # Clean up the temporary extraction directory.
-    shutil.rmtree(extract_root)
-
-    return train_dir, test_dir, labels
