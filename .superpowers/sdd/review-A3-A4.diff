-                datasets["testing"],
-                exe,
-                size=SMALL_TEST_SIZE,
-                seed=43,
-                stratify_by_column=STRATIFY_COLUMN,
-                element_table="Image",
-                include_tables=["Image", "Image_Class"],
-                dataset_types=["Testing", "Labeled"],
-                description=descriptions["small_testing"],
