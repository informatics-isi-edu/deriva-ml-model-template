-    dataset_urls: dict[str, str] = {}
-    if args.show_urls and datasets:
-        logger.info("Fetching Chaise URLs for datasets...")
-        for name, rid in datasets.items():
-            try:
-                dataset_urls[name] = ml.cite(rid, current=True)
