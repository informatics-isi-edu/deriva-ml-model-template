-    "# Find execution with no confidence scores (ground truth). When more\n",
-    "# than one execution has Confidence-NULL rows (e.g. a partial\n",
-    "# loader-images attempt followed by a successful retry both leave GT\n",
-    "# rows on Image_Classification), pick the one covering the most\n",
-    "# images rather than the first by index order — picking by index\n",
-    "# silently truncates the joined sample to the smaller GT set.\n",
-    "gt_mask = exec_summary['with_confidence'] == 0\n",
-    "if gt_mask.any():\n",
